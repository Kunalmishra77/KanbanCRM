# --- Supabase (database + file storage) ---
# Database: Supabase -> Project Settings -> Database -> Connection string (use the Transaction pooler, port 6543)
DATABASE_URL=

# Storage: Supabase -> Project Settings -> API
# The service-role key bypasses security rules. Server only - never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_URL=
NODE_ENV=production
PORT=5000
SESSION_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated co-founder (admin) emails. Optional; a default list is built in.
CO_FOUNDER_EMAILS=

# Secret the scheduler sends as "Authorization: Bearer <secret>" to /api/cron/check-deadlines
CRON_SECRET=

# Optional: AI features
GEMINI_API_KEY=
