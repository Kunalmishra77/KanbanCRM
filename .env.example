# Database (Postgres)
DATABASE_URL=

# Public app URL and server runtime
APP_URL=
NODE_ENV=production
PORT=5000
SESSION_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated co-founder (admin) emails. Optional; a default list is built in.
CO_FOUNDER_EMAILS=

# Secret the scheduler sends as "Authorization: Bearer <secret>" to /api/cron/check-deadlines
CRON_SECRET=

# Uploaded files are stored on disk here (default: ./storage). Mount a persistent volume on this path in Docker/Coolify.
STORAGE_DIR=

# Optional: AI features
GEMINI_API_KEY=
